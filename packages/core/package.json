{
  "name": "@studio/core",
  "version": "0.0.0",
  "description": "Schema, migrations, site handlers, content reads and admin for studio-built sites. See SPEC.md.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations",
    "SPEC.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js",
      "default": "./dist/db/schema.js"
    },
    "./migrations": {
      "types": "./migrations/index.d.ts",
      "import": "./migrations/index.js",
      "default": "./migrations/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrations:generate": "drizzle-kit generate",
    "migrations:check": "drizzle-kit check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-blockquote": "^3.30.5",
    "@tiptap/extension-bold": "^3.30.5",
    "@tiptap/extension-document": "^3.30.5",
    "@tiptap/extension-hard-break": "^3.30.5",
    "@tiptap/extension-heading": "^3.30.5",
    "@tiptap/extension-italic": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-list": "^3.30.5",
    "@tiptap/extension-paragraph": "^3.30.5",
    "@tiptap/extension-text": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "resend": "^6.25.0",
    "stripe": "^22.6.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
