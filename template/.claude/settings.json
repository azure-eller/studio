{
  "//": "For interactive sessions. The pipeline runs claude -p with permissions bypassed; this file does not apply there.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(pnpm scaffold*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build*)",
      "Bash(pnpm check:site*)",
      "Bash(pnpm db:seed*)",
      "Bash(pnpm db:migrate*)",
      "Bash(pnpm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": ["Bash(pnpm add*)", "Bash(pnpm install*)", "Bash(npm *)", "Bash(rm -rf*)", "Bash(curl*)", "Bash(wget*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "pnpm exec prettier --write \"$CLAUDE_FILE_PATHS\" >/dev/null 2>&1 || true" }]
      }
    ]
  }
}
