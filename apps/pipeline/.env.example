# Fill in as apps/pipeline/.env (gitignored). `pnpm pipeline …` and scripts/pipeline-env.sh load it.
STUDIO_DATABASE_URL=            # Neon project "studio", pooled URL — created by scripts/bootstrap-studio.sh once NEON_API_KEY exists
STUDIO_DOMAIN=                  # e.g. example.com — a zone in your Cloudflare account; sites go to <slug>.<STUDIO_DOMAIN>
TEMPLATE_DIR=/home/azure/Projects/agentic-web-design/template
DESIGNER_EMAIL=azureller1@gmail.com
EMAIL_FROM="Studio <noreply@example.com>"   # on a Resend-verified domain
MEDIA_BASE_URL=                 # https://media.<STUDIO_DOMAIN> (R2 custom domain) — or the r2.dev URL for testing
GH_PAT=                         # `gh auth token` works (scopes: repo)
GH_ORG=azure-eller              # personal account for now
VERCEL_TOKEN=                   # https://vercel.com/account/settings/tokens
#VERCEL_TEAM_ID=                # leave unset for the personal scope
NEON_API_KEY=                   # https://console.neon.tech/app/settings/api-keys
#NEON_ORG_ID=
NEON_REGION=aws-us-west-2
CF_API_TOKEN=                   # Cloudflare token: Zone → DNS → Edit on the studio zone
CF_ZONE_ID=                     # zone overview page, right column
CF_ACCOUNT_ID=                  # same page
R2_ACCESS_KEY_ID=               # R2 → Manage R2 API tokens → Object Read & Write
R2_SECRET_ACCESS_KEY=
R2_BUCKET=studio-media
RESEND_API_KEY=                 # https://resend.com/api-keys
#CLAUDE_CODE_OAUTH_TOKEN=       # only for GitHub Actions (`claude setup-token`); local runs use your `claude` login
DRY_RUN=0
